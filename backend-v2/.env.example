# MongoDB (local or Atlas)
MONGO_URL=mongodb://localhost:27017
DB_NAME=scang

# CORS — comma-separated origins, or * for open
CORS_ORIGINS=*

# Firebase Admin (prefer JSON string on cloud hosts)
# Paste the full service-account JSON as a single line:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
FIREBASE_CREDENTIALS_JSON=

# Local only — path to service-account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

# Optional — protects /api/ingestion/* when set
INGESTION_ADMIN_KEY=

# Optional — Windows Tesseract path if not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Razorpay (Premium subscriptions) — use Test mode keys first
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan IDs from Razorpay Dashboard → Subscriptions → Plans (must match amounts in payment_service PLAN_CATALOG)
RAZORPAY_PLAN_ID_MONTHLY=
RAZORPAY_PLAN_ID_YEARLY=
