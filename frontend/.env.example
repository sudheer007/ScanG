# Base URL of the ScanG backend (no trailing slash, no /api suffix)
# Local: http://localhost:8000
# Production: https://scang-api.onrender.com
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Google Sign-In (web only for now). Optional — the sign-in button shows a
# "not configured" note if unset, rest of the app is unaffected. Must match
# the GOOGLE_CLIENT_ID configured on the backend. Create it at
# https://console.cloud.google.com/apis/credentials (OAuth client, type
# "Web application", add this site's origin under "Authorized JavaScript
# origins" — no redirect URI needed for the GIS button flow).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
