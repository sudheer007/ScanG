# MongoDB connection string (local or MongoDB Atlas)
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=scang

# Google Gemini API key for the AI Research Analyst (Track C). Optional —
# that endpoint returns 503 if unset. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Google Sign-In. Optional — /api/auth/* returns 503 if unset, rest of the app
# is unaffected. Create an OAuth "Web application" client at
# https://console.cloud.google.com/apis/credentials, add your frontend origin
# (e.g. https://scang.pages.dev and http://localhost:8081) under
# "Authorized JavaScript origins", then paste the client ID here.
# Comma-separate multiple client IDs (e.g. web + iOS + Android) if ever needed.
GOOGLE_CLIENT_ID=

# Secret used to sign our own session JWTs issued after Google verification.
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
