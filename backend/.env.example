# MongoDB connection string (local or MongoDB Atlas)
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=scang

# Anthropic API key for the AI Research Analyst (Track C). Optional — that
# endpoint returns 503 if unset. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
