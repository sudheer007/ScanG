# Copy to .env and fill values from Firebase / Google Cloud.
# For Render / production web builds, set EXPO_PUBLIC_BACKEND_URL to the
# live API (no trailing slash), e.g. https://scang-api.onrender.com

# Physical Android device: use your PC LAN IP (ipconfig)
# Android emulator: use http://10.0.2.2:8000
EXPO_PUBLIC_BACKEND_URL=http://192.168.0.103:8000

# Firebase web app config (Project settings -> Your apps -> Web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=fintech-58166.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=fintech-58166
EXPO_PUBLIC_FIREBASE_APP_ID=1:384267234007:web:344f60bc7628baa55f9e92

# Google OAuth client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Required for Android Google sign-in after adding debug SHA-1 in Firebase.
# Run: yarn android:sha1
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
